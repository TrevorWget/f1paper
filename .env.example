# Copy to .env and fill in. Never commit the real .env file.

# --- Reddit (required for the reddit source) ---
# Create a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=f1paper/0.1.0 by <your_reddit_username>

# --- X / Twitter (required for the twitter source) ---
# Add at least one account to the twscrape pool first:
#   twscrape add_accounts accounts.txt username:password:email:email_password
#   twscrape login_accounts
TWSCRAPE_DB_PATH=

# --- Instagram (optional, reduces rate limiting for the instagram source) ---
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- jolpica-f1 schedule API (required custom User-Agent per their terms) ---
F1PAPER_USER_AGENT=f1paper/0.1.0 (contact: you@example.com)
